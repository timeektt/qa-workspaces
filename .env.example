# Jira REST config — คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# API token: https://id.atlassian.com/manage-profile/security/api-tokens

# ---------- บังคับ (ขาดตัวใดตัวหนึ่ง หน้าเว็บจะไม่แสดงข้อมูล) ----------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=ABC

# ---------- ไม่บังคับ (ลบ # ข้างหน้าออกถ้าจะใช้ ไม่งั้นใช้ค่า default) ----------

# Epic key ที่ผูก issue ที่เปิดใหม่ทุกใบเป็นค่าเริ่มต้น
# ค่าที่ใส่ = issue key ของ Epic เอง (เปิด Epic ใน Jira แล้วดู key ท้าย URL .../browse/ABC-100)
# ไม่ใส่ / ว่าง = ไม่ผูก epic
# JIRA_DEFAULT_EPIC=ABC-100

# custom field id ของช่อง Sprint บน create screen
# ค่า default customfield_10020 ใช้ได้กับ Jira Cloud ส่วนใหญ่ — ปกติไม่ต้องแก้
# ถ้าของทีมเป็นเลขอื่น: ถามแอดมิน Jira หรือดูจาก GET /rest/api/3/field แล้วหา field ชื่อ "Sprint"
# JIRA_SPRINT_FIELD=customfield_10020

# พอร์ตของ server — ไม่ใส่ = ใช้ 3060 (http://localhost:3060)
# ใส่ต่อเมื่ออยากเปลี่ยน port เท่านั้น
# PORT=3060

# แท็บ "ติดตาม issue" — เก็บรอบติดตามบน Google Sheet ให้ทั้งทีมเห็นข้อมูลชุดเดียวกัน
# ไม่ตั้ง 2 ค่านี้ = เก็บเป็นไฟล์ในเครื่องตัวเอง (agent-data/jira-drafts/rounds.json) เห็นคนเดียว
# วิธีสร้างชีต + deploy: tools/qa-workspace/apps-script/README.md
# ⚠️ ใครมี URL + token คู่นี้ เพิ่ม/ลบข้อมูลรอบได้ทั้งหมด — ห้าม commit ค่าจริงลง git
ROUNDS_SHEET_URL=
ROUNDS_SHEET_TOKEN=
